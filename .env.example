# Copy to .env.local and fill in. Add the same keys in Vercel (Production + Preview).

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives "Book a call" requests
SALES_EMAIL=

# Base URL for the alpha videos. `/videos` serves public/videos locally;
# in Vercel, point it at the R2 custom domain, e.g. https://assets.yourdomain.com
NEXT_PUBLIC_ASSETS_URL=/videos
